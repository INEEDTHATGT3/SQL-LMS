{
  "name": "sql-lms",
  "private": true,
  "version": "3.0.0",
  "description": "Layered SQL curriculum as a React SPA: LeetCode SQL 50 spine, four tiers per module, in-browser PostgreSQL (PGlite), spaced review.",
  "type": "module",
  "license": "MIT",
  "author": "Dhruv Jaiswal",
  "engines": { "node": ">=20" },
  "scripts": {
    "gen": "node scripts/gen.mjs",
    "predev": "npm run gen",
    "dev": "vite",
    "prebuild": "npm run sync:problems && npm run verify && npm run gen",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:content": "node scripts/lint-content.mjs",
    "sync:problems": "node scripts/sync-problems.mjs",
    "check:provenance": "node scripts/check-provenance.mjs",
    "check:exercises": "node scripts/check-exercises.mjs",
    "check:links": "node scripts/check-links.mjs",
    "coverage": "node scripts/solution-coverage.mjs",
    "maintain:sourcing": "node scripts/maintain-sourcing.mjs",
    "test:engines": "node scripts/test-engines.mjs",
    "verify": "npm run check:provenance && npm run lint:content",
    "harness": "node harness/run.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "vite": "^5.4.8"
  }
}
