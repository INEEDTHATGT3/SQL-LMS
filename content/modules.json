{
  "version": "1.0",
  "orderSource": "Progressive complexity: syntax → filtering → joins → aggregation → windows → analytics",
  "tierRule": {
    "L1": "Single concept, guided",
    "L2": "Combinations, EXPLAIN",
    "L3": "Optimization, dialects",
    "L4": "Internals, partitioning"
  },
  "modules": [
    {
      "id": "basics",
      "num": "01",
      "title": "SQL Fundamentals",
      "subtitle": "SELECT, WHERE, ORDER BY, LIMIT",
      "deps": [],
      "status": "active"
    },
    {
      "id": "filtering",
      "num": "02",
      "title": "Filtering & Conditionals",
      "subtitle": "IN, BETWEEN, LIKE, CASE, NULL handling",
      "deps": ["basics"],
      "status": "active"
    },
    {
      "id": "joins",
      "num": "03",
      "title": "Joins & Set Operations",
      "subtitle": "INNER/LEFT/RIGHT/FULL, UNION, EXCEPT, INTERSECT",
      "deps": ["filtering"],
      "status": "active"
    },
    {
      "id": "aggregation",
      "num": "04",
      "title": "Aggregation & Grouping",
      "subtitle": "GROUP BY, HAVING, rollup, cube, grouping sets",
      "deps": ["joins"],
      "status": "active"
    },
    {
      "id": "window-functions",
      "num": "05",
      "title": "Window Functions",
      "subtitle": "ROW_NUMBER, RANK, LAG/LEAD, frames",
      "deps": ["aggregation"],
      "status": "active"
    },
    {
      "id": "subqueries-ctes",
      "num": "06",
      "title": "Subqueries & CTEs",
      "subtitle": "Correlated, recursive CTEs, materialization",
      "deps": ["window-functions"],
      "status": "active"
    },
    {
      "id": "performance",
      "num": "07",
      "title": "Performance & Indexing",
      "subtitle": "EXPLAIN, indexes, statistics, tuning",
      "deps": ["subqueries-ctes"],
      "status": "active"
    },
    {
      "id": "advanced-analytics",
      "num": "08",
      "title": "Advanced Analytics",
      "subtitle": "Pivot, lateral, advanced frames, sampling",
      "deps": ["performance"],
      "status": "active"
    },
    {
      "id": "timeseries-geo",
      "num": "09",
      "title": "Time-Series & Geospatial",
      "subtitle": "Gap filling, interpolation, PostGIS basics, H3",
      "deps": ["advanced-analytics"],
      "status": "active"
    },
    {
      "id": "stored-procs",
      "num": "10",
      "title": "Stored Procedures & Functions",
      "subtitle": "CREATE PROCEDURE/FUNCTION, params, returns, transactions, cursors",
      "deps": ["advanced-analytics"],
      "status": "active"
    },
    {
      "id": "triggers",
      "num": "11",
      "title": "Triggers & Transaction Control",
      "subtitle": "CREATE TRIGGER, BEFORE/AFTER/INSTEAD OF, audit, constraints",
      "deps": ["stored-procs"],
      "status": "active"
    }
  ],
  "levels": [
    {
      "level": 1,
      "name": "BEGINNER",
      "color": "#00b4d8",
      "promise": "Core syntax, mental models. Tables as grids."
    },
    {
      "level": 2,
      "name": "INTERVIEW READY",
      "color": "#90e0ef",
      "promise": "Joins, grouping, windows. Standard patterns."
    },
    {
      "level": 3,
      "name": "ADVANCED",
      "color": "#caf0f8",
      "promise": "CTEs, recursive, query optimization, dialects."
    },
    {
      "level": 4,
      "name": "EXPERT",
      "color": "#0077b6",
      "promise": "Execution plans, partitioning, stored procs, triggers."
    }
  ]
}