  "revisionCard": [
    "IN = multiple OR; NOT IN = multiple AND (watch for NULLs in subquery!)",
    "BETWEEN = inclusive range; works on numbers, dates, strings",
    "LIKE: % = any chars, _ = one char; leading % kills index",
    "PostgreSQL: ILIKE for case-insensitive; MySQL: LIKE is case-insensitive by default",
    "CASE: simple (equality) vs searched (conditions); always include ELSE",
    "COALESCE = first non-NULL; NULLIF(a,b) = NULL if a=b else a"
  ],
  "glossary": [
    {
      "term": "predicate",
      "def": "Boolean expression in WHERE/HAVING that evaluates per row."
    },
    {
      "term": "sargable",
      "def": "Search ARGument ABLE — predicate that can use index (e.g., col = 5, not UPPER(col) = 'X')."
    },
    {
      "term": "wildcard",
      "def": "% (zero+ chars) and _ (exactly one char) in LIKE patterns."
    },
    {
      "term": "searched CASE",
      "def": "CASE WHEN condition THEN result — conditions evaluated in order."
    },
    {
      "term": "simple CASE",
      "def": "CASE expr WHEN val THEN result — equality checks against expr."
    },
    {
      "term": "three-valued logic",
      "def": "TRUE, FALSE, UNKNOWN (NULL). WHERE filters keep only TRUE."
    }
  ]
