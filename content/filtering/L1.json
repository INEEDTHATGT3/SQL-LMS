{
  "level": 1,
  "title": "Filtering & Conditionals",
  "tagline": "IN, BETWEEN, LIKE, CASE, NULL — precision filtering",
  "placementQuiz": [
    {
      "q": "WHERE status IN ('active', 'pending') is equivalent to:",
      "options": [
        "status = 'active' AND status = 'pending'",
        "status = 'active' OR status = 'pending'",
        "status BETWEEN 'active' AND 'pending'",
        "status LIKE 'active%'"
      ],
      "answer": 1,
      "explain": "IN is shorthand for multiple OR conditions."
    },
    {
      "q": "WHERE name LIKE 'J_n' matches:",
      "options": [
        "Names starting with J",
        "3-letter names starting with J (Jan, Jon, Jun)",
        "Names containing 'Jn'",
        "Only 'J_n' literally"
      ],
      "answer": 1,
      "explain": "_ matches exactly one character. 'J_n' = J + any char + n."
    },
    {
      "q": "WHERE salary BETWEEN 50000 AND 75000 includes:",
      "options": [
        "Salaries >50000 and <75000",
        "Salaries ≥50000 and ≤75000",
        "Only 50000 and 75000",
        "Salaries ≥50000 and <75000"
      ],
      "answer": 1,
      "explain": "BETWEEN is inclusive on both ends."
    },
    {
      "q": "To find NULL values in a column:",
      "options": [
        "WHERE col = NULL",
        "WHERE col IS NULL",
        "WHERE col == NULL",
        "WHERE col <> NULL"
      ],
      "answer": 1,
      "explain": "NULL is not a value — use IS NULL / IS NOT NULL."
    },
    {
      "q": "CASE WHEN salary > 100000 THEN 'high' ELSE 'normal' END returns:",
      "options": [
        "A boolean",
        "A string: 'high' or 'normal'",
        "An integer",
        "NULL"
      ],
      "answer": 1,
      "explain": "CASE expression returns the THEN/ELSE result value."
    }
  ],
  "sections": [
    {
      "title": "Mental Model — The Filter Funnel",
      "blocks": [
        {
          "type": "mantra",
          "md": "**WHERE is a funnel: rows enter, predicates test each row, only passing rows exit. Order of predicates doesn't change results (optimizer reorders), but can change performance.**"
        },
        {
          "type": "visual",
          "kind": "schema-diagram",
          "spec": {
            "tables": [
              {
                "name": "employees",
                "columns": [
                  {
                    "name": "id",
                    "type": "INTEGER",
                    "pk": true
                  },
                  {
                    "name": "name",
                    "type": "VARCHAR(100)"
                  },
                  {
                    "name": "dept_id",
                    "type": "INTEGER"
                  },
                  {
                    "name": "salary",
                    "type": "DECIMAL(10,2)"
                  },
                  {
                    "name": "status",
                    "type": "VARCHAR(20)"
                  },
                  {
                    "name": "manager_id",
                    "type": "INTEGER"
                  }
                ]
              }
            ]
          }
        },
        {
          "type": "prose",
          "md": "Imagine pouring a bucket of rows through a series of screens. Each screen = a predicate (salary > 50000, status = 'active', etc.). Rows that match pass through; others are caught. The final stream is your result set."
        },
        {
          "type": "list",
          "items": [
            "Each predicate = independent true/false test per row",
            "AND = all screens must pass; OR = any screen passes",
            "NOT = invert the screen",
            "NULL fails all comparisons (=, <, >, LIKE, IN) — use IS NULL"
          ]
        }
      ]
    },
    {
      "title": "List & Range Filters — IN, BETWEEN",
      "blocks": [
        {
          "type": "heading",
          "text": "IN — Clean List Matching"
        },
        {
          "type": "code",
          "label": "in / not in",
          "code": "-- Multiple values\nSELECT * FROM employees WHERE dept_id IN (1, 3, 5);\n\n-- Equivalent to:\nSELECT * FROM employees WHERE dept_id = 1 OR dept_id = 3 OR dept_id = 5;\n\n-- Exclude\nSELECT * FROM employees WHERE dept_id NOT IN (2, 4);\n\n-- With subquery (preview)\nSELECT * FROM employees \nWHERE dept_id IN (SELECT id FROM departments WHERE location = 'NYC');",
          "pg": "-- Same syntax\n-- NOT IN with subquery: watch for NULLs in subquery result!",
          "mysql": "-- Same syntax\n-- MySQL optimizes IN (subquery) to semi-join",
          "py-pandas": "# IN\ne = employees[employees['dept_id'].isin([1, 3, 5])]\n\n# NOT IN\ne = employees[~employees['dept_id'].isin([2, 4])]\n\n# Subquery\nnyc_depts = departments[departments['location'] == 'NYC']['id']\ne = employees[employees['dept_id'].isin(nyc_depts)]",
          "py-sqlalchemy": "# IN\nsession.query(Employee).filter(Employee.dept_id.in_([1, 3, 5])).all()\n\n# NOT IN\nsession.query(Employee).filter(~Employee.dept_id.in_([2, 4])).all()\n\n# Subquery\nnyc_subq = session.query(Department.id).filter(Department.location == 'NYC')\nsession.query(Employee).filter(Employee.dept_id.in_(nyc_subq)).all()"
        },
        {
          "type": "heading",
          "text": "BETWEEN — Inclusive Range"
        },
        {
          "type": "code",
          "label": "between",
          "code": "-- Numeric range\nSELECT * FROM employees WHERE salary BETWEEN 50000 AND 80000;\n\n-- Equivalent:\nSELECT * FROM employees WHERE salary >= 50000 AND salary <= 80000;\n\n-- Date range\nSELECT * FROM employees WHERE hire_date BETWEEN '2023-01-01' AND '2023-12-31';",
          "pg": "-- Timestamp range\nSELECT * FROM events WHERE created_at BETWEEN '2024-01-01' AND '2024-01-31 23:59:59';",
          "mysql": "-- Same syntax",
          "py-pandas": "# Numeric\ne = employees[(employees['salary'] >= 50000) & (employees['salary'] <= 80000)]\n\n# Date\ne = employees[(employees['hire_date'] >= '2023-01-01') & (employees['hire_date'] <= '2023-12-31')]",
          "py-sqlalchemy": "# Date range\nfrom sqlalchemy import between\nsession.query(Employee).filter(between(Employee.hire_date, '2023-01-01', '2023-12-31')).all()"
        },
        {
          "type": "quiz",
          "items": [
            {
              "q": "WHERE x IN (1,2,3) is internally rewritten as:",
              "options": [
                "x = 1 AND x = 2 AND x = 3",
                "x = 1 OR x = 2 OR x = 3",
                "x BETWEEN 1 AND 3",
                "x = ANY(ARRAY[1,2,3])"
              ],
              "answer": 1,
              "explain": "IN expands to OR chain. A row can't equal 1 AND 2 simultaneously."
            },
            {
              "q": "BETWEEN 10 AND 20 with x = 10 returns:",
              "options": [
                "FALSE (exclusive)",
                "TRUE (inclusive)",
                "NULL",
                "Error"
              ],
              "answer": 1,
              "explain": "BETWEEN is inclusive: x >= 10 AND x <= 20."
            }
          ]
        }
      ]
    },
    {
      "title": "Pattern Matching — LIKE, ILIKE",
      "blocks": [
        {
          "type": "heading",
          "text": "LIKE Wildcards"
        },
        {
          "type": "code",
          "label": "like patterns",
          "code": "-- Starts with\nSELECT * FROM employees WHERE name LIKE 'A%';\n\n-- Ends with\nSELECT * FROM employees WHERE email LIKE '%@company.com';\n\n-- Contains\nSELECT * FROM employees WHERE name LIKE '%son%';\n\n-- Single char: _\nSELECT * FROM employees WHERE name LIKE 'J_n';  -- Jan, Jon, Jun\n\n-- Escape literal % or _\nSELECT * FROM employees WHERE code LIKE '100\\%%' ESCAPE '\\\\';",
          "pg": "-- Case-insensitive (PostgreSQL)\nSELECT * FROM employees WHERE name ILIKE 'a%';\n\n-- SIMILAR TO (regex-like)\nSELECT * FROM employees WHERE name SIMILAR TO '[A-C]%';",
          "mysql": "-- Case-insensitive by default\nSELECT * FROM employees WHERE name LIKE 'a%';\n\n-- REGEXP for regex\nSELECT * FROM employees WHERE name REGEXP '^[A-C]';",
          "py-pandas": "# Starts with\ne = employees[employees['name'].str.startswith('A')]\n\n# Ends with\ne = employees[employees['email'].str.endswith('@company.com')]\n\n# Contains\ne = employees[employees['name'].str.contains('son')]\n\n# Regex\ne = employees[employees['name'].str.match(r'^J.n$')]",
          "py-sqlalchemy": "# Starts with\nsession.query(Employee).filter(Employee.name.like('A%')).all()\n\n# Ends with\nsession.query(Employee).filter(Employee.email.like('%@company.com')).all()\n\n# Contains\nsession.query(Employee).filter(Employee.name.like('%son%')).all()\n\n# Case-insensitive\nsession.query(Employee).filter(Employee.name.ilike('a%')).all()"
        },
        {
          "type": "callout",
          "tone": "warn",
          "md": "**Leading % kills index usage.** `LIKE '%son'` → Seq Scan. Trailing `%` (`LIKE 'J%'`) can use B-tree index. For leading wildcard search, see L3: pg_trgm (PostgreSQL) or FULLTEXT (MySQL)."
        },
        {
          "type": "quiz",
          "items": [
            {
              "q": "LIKE '_at' matches:",
              "options": [
                "cat, bat, rat",
                "cat, bat, rat, catfish",
                "at, bat",
                "only 'at'"
              ],
              "answer": 0,
              "explain": "_ = exactly one character. '_at' = 3 chars ending in 'at'."
            },
            {
              "q": "PostgreSQL case-insensitive LIKE is:",
              "options": [
                "LIKE",
                "ILIKE",
                "LIKE_CASELESS",
                "COLLATE NOCASE"
              ],
              "answer": 1,
              "explain": "ILIKE is PostgreSQL-specific case-insensitive pattern match."
            }
          ]
        },
        {
          "type": "query-plan",
          "title": "EXPLAIN — IN vs OR Predicate",
          "plan": {
