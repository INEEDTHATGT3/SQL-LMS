    {
      "title": "Conditional Logic — CASE, COALESCE, NULLIF",
      "blocks": [
        {
          "type": "heading",
          "text": "CASE Expression"
        },
        {
          "type": "code",
          "label": "case basics",
          "code": "-- Simple CASE (equality)\nSELECT name,\n  CASE dept_id\n    WHEN 1 THEN 'Engineering'\n    WHEN 2 THEN 'Sales'\n    WHEN 3 THEN 'Marketing'\n    ELSE 'Other'\n  END AS department\nFROM employees;\n\n-- Searched CASE (conditions)\nSELECT name, salary,\n  CASE\n    WHEN salary >= 100000 THEN 'Senior'\n    WHEN salary >= 70000 THEN 'Mid'\n    ELSE 'Junior'\n  END AS level\nFROM employees;",
          "pg": "-- Same syntax",
          "mysql": "-- Same syntax",
          "py-pandas": "# Simple mapping\ndept_map = {1: 'Engineering', 2: 'Sales', 3: 'Marketing'}\ne['department'] = e['dept_id'].map(dept_map).fillna('Other')\n\n# Searched case\nimport numpy as np\ne['level'] = np.where(e['salary'] >= 100000, 'Senior',\n               np.where(e['salary'] >= 70000, 'Mid', 'Junior'))",
          "py-sqlalchemy": "# Simple case\nfrom sqlalchemy import case\nsession.query(Employee.name,\n    case(Employee.dept_id, {1: 'Engineering', 2: 'Sales', 3: 'Marketing'}, else_='Other')\n).all()\n\n# Searched case\nsession.query(Employee.name,\n    case(\n        (Employee.salary >= 100000, 'Senior'),\n        (Employee.salary >= 70000, 'Mid'),\n        else_='Junior'\n    )\n).all()"
        },
        {
          "type": "heading",
          "text": "NULL Handling — COALESCE, NULLIF"
        },
        {
          "type": "code",
          "label": "coalesce / nullif",
          "code": "-- COALESCE: first non-NULL\nSELECT COALESCE(manager_id, 0) AS mgr FROM employees;\n-- If manager_id is NULL, returns 0\n\n-- NULLIF: returns NULL if equal\nSELECT NULLIF(status, '') FROM employees;\n-- Empty string becomes NULL\n\n-- Combined: normalize then coalesce\nSELECT COALESCE(NULLIF(TRIM(phone), ''), 'N/A') FROM employees;",
          "pg": "-- Same syntax",
          "mysql": "-- IFNULL (2 args only)\nSELECT IFNULL(manager_id, 0) FROM employees;\n\n-- NULLIF same",
          "py-pandas": "# COALESCE → fillna\ne['manager_id'] = e['manager_id'].fillna(0)\n\n# NULLIF → replace then fillna\ne['status'] = e['status'].replace('', np.nan)",
          "py-sqlalchemy": "# COALESCE\nfrom sqlalchemy import func\nsession.query(func.coalesce(Employee.manager_id, 0)).all()\n\n# NULLIF\nsession.query(func.nullif(Employee.status, '')).all()"
        },
        {
          "type": "quiz",
          "items": [
            {
              "q": "COALESCE(NULL, 1, 2) returns:",
              "options": [
                "NULL",
                "1",
                "2",
                "Error"
              ],
              "answer": 1,
              "explain": "COALESCE returns first non-NULL argument."
            },
            {
              "q": "NULLIF(5, 5) returns:",
              "options": [
                "5",
                "0",
                "NULL",
                "Error"
              ],
              "answer": 2,
              "explain": "NULLIF(a,b) returns NULL if a=b, else a."
            }
          ]
        }
      ]
    },
