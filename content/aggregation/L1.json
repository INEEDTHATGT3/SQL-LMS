  "revisionCard": [
    "COUNT(*) = all rows; COUNT(col) = non-NULL only",
    "SUM, AVG, MIN, MAX ignore NULLs",
    "GROUP BY: non-aggregate columns in SELECT must appear in GROUP BY",
    "WHERE = row filter (before GROUP BY); HAVING = group filter (after GROUP BY)",
    "GROUP BY expressions allowed: EXTRACT(YEAR FROM date), dept_id + status",
    "NULLs group together in GROUP BY"
  ],
  "glossary": [
    {
      "term": "aggregate function",
      "def": "Computes single value from multiple rows: COUNT, SUM, AVG, MIN, MAX."
    },
    {
      "term": "GROUP BY",
      "def": "Collapses rows with same key values into one row per group."
    },
    {
      "term": "HAVING",
      "def": "Filters groups after aggregation (vs WHERE filters rows before)."
    },
    {
      "term": "bucket",
      "def": "A group of rows with same GROUP BY key values."
    },
    {
      "term": "aggregate expression",
      "def": "Expression containing aggregate function (e.g., COUNT(*) + 1)."
    },
    {
      "term": "null group",
      "def": "All rows with NULL in GROUP BY column form one group together."
    }
  ]
}
