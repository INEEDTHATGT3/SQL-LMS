              },
              {
                "row_type": "Subtotal (dept=NULL, status=active)",
                "grouping_dept": 1,
                "grouping_status": 0,
                "grouping_id": 2
              },
              {
                "row_type": "Grand Total (NULL, NULL)",
                "grouping_dept": 1,
                "grouping_status": 1,
                "grouping_id": 3
              }
            ],
            "after": [],
            "highlight": [
              "grouping_id"
            ]
          }
        },
        {
          "type": "quiz",
          "items": [
            {
              "q": "GROUPING(dept_id) = 1 means:",
              "options": [
                "dept_id is NULL in source data",
                "Row is subtotal where dept_id was rolled up",
                "dept_id = 1",
                "Error"
              ],
              "answer": 1,
              "explain": "GROUPING(col) = 1 when col is NULL because it was rolled up (subtotal/grand total)."
            },
            {
              "q": "GROUPING_ID(dept, status) = 3 (binary 11) means:",
              "options": [
                "Detail row",
                "dept subtotal",
                "status subtotal",
                "Grand total (both rolled)"
              ],
              "answer": 3,
              "explain": "Bit 0 = status rolled, Bit 1 = dept rolled. 11 = both = grand total."
            }
          ]
        }
      ]
