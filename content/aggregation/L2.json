    {
      "title": "ROLLUP — Hierarchical Subtotals",
      "blocks": [
        {
          "type": "heading",
          "text": "ROLLUP Syntax & Behavior"
        },
        {
          "type": "code",
          "label": "rollup examples",
          "code": "-- Single column: detail + grand total\nSELECT dept_id, COUNT(*)\nFROM employees\nGROUP BY ROLLUP(dept_id);\n-- Result: 5 dept rows + 1 grand total (dept_id=NULL)\n\n-- Two columns: detail + subtotals + grand\nSELECT dept_id, status, COUNT(*)\nFROM employees\nGROUP BY ROLLUP(dept_id, status);\n-- Hierarchy: (dept,status) → (dept) → ()\n\n-- Partial rollup\nSELECT dept_id, status, COUNT(*)\nFROM employees\nGROUP BY dept_id, ROLLUP(status);\n-- Detail (dept,status) + (dept) subtotals + grand total",
          "pg": "-- Same syntax",
          "mysql": "-- MySQL 8.0+: ROLLUP supported\nSELECT dept_id, status, COUNT(*) FROM employees GROUP BY dept_id, status WITH ROLLUP;",
          "py-pandas": "# ROLLUP via pivot_table margins\ndf.pivot_table(index=['dept_id', 'status'], values='id', aggfunc='count', margins=True)"
        },
        {
          "type": "query-plan",
          "title": "EXPLAIN — ROLLUP",
          "plan": {
            "Plan": {
              "Node Type": "GroupAggregate",
              "Strategy": "Sorted",
              "Group Key": [
                "dept_id",
                "status"
              ],
              "Grouping Sets": "[[dept_id, status], [dept_id], []]",
              "Startup Cost": 100,
              "Total Cost": 500,
              "Plan Rows": 30,
              "Plan Width": 24
            }
          },
          "dialect": "pg"
        },
        {
          "type": "quiz",
          "items": [
            {
              "q": "ROLLUP(a, b, c) produces how many grouping levels?",
              "options": [
                "3",
                "4",
                "8",
                "2^3 = 8"
              ],
              "answer": 1,
              "explain": "ROLLUP: N columns = N+1 levels. (a,b,c) + (a,b) + (a) + () = 4 levels."
            },
            {
              "q": "GROUP BY a, ROLLUP(b) vs GROUP BY ROLLUP(a, b):",
              "options": [
                "Same",
                "First: (a,b) + (a) + (); Second: (a,b) + (a) + ()",
                "First: (a,b) + (a); Second: (a,b) + (a) + ()",
                "First includes (b) subtotal"
              ],
              "answer": 2,
              "explain": "GROUP BY a, ROLLUP(b) = (a,b) + (a). GROUP BY ROLLUP(a,b) = (a,b) + (a) + ()."
            }
          ]
        }
      ]
    },
    {
      "title": "CUBE & GROUPING SETS — Full Cross-Tab",
      "blocks": [
        {
          "type": "heading",
          "text": "CUBE — All Combinations"
        },
        {
          "type": "code",
          "label": "cube examples",
          "code": "-- Full cross-tab\nSELECT dept_id, status, COUNT(*)\nFROM employees\nGROUP BY CUBE(dept_id, status);\n-- Groups: (dept,status), (dept), (status), ()\n\n-- CUBE with 3 columns = 8 combinations\nSELECT a, b, c, COUNT(*)\nFROM t\nGROUP BY CUBE(a, b, c);\n-- (a,b,c), (a,b), (a,c), (b,c), (a), (b), (c), ()",
          "pg": "-- Same syntax",
          "mysql": "-- MySQL 8.0+: CUBE supported\nSELECT dept_id, status, COUNT(*) FROM employees GROUP BY dept_id, status WITH CUBE;",
          "py-pandas": "# CUBE via multiple pivot_tables\nimport itertools\nresults = []\nfor r in range(3):\n    for cols in itertools.combinations(['dept_id', 'status'], r+1):\n        results.append(df.groupby(list(cols)).size().reset_index(name='count'))\npd.concat(results)"
        },
        {
          "type": "heading",
          "text": "GROUPING SETS — Pick Your Own"
        },
        {
          "type": "code",
          "label": "grouping sets",
          "code": "-- Only dept subtotals + grand total (no status subtotals)\nSELECT dept_id, status, COUNT(*)\nFROM employees\nGROUP BY GROUPING SETS ((dept_id, status), (dept_id), ());\n\n-- Only status subtotals\nSELECT dept_id, status, COUNT(*)\nFROM employees\nGROUP BY GROUPING SETS ((status), ());\n\n-- Equivalent to CUBE but explicit\nSELECT dept_id, status, COUNT(*)\nFROM employees\nGROUP BY GROUPING SETS ((dept_id, status), (dept_id), (status), ());",
          "pg": "-- GROUPING SETS is standard SQL",
          "mysql": "-- MySQL 8.0+: GROUPING SETS supported",
          "py-pandas": "# Manual GROUPING SETS\nsets = [['dept_id', 'status'], ['dept_id'], ['status'], []]\nresults = [df.groupby(cols).size().reset_index(name='count') for cols in sets]\npd.concat(results, ignore_index=True)"
        },
        {
          "type": "quiz",
          "items": [
            {
              "q": "GROUPING SETS ((a,b), (a)) produces groups:",
              "options": [
                "(a,b), (a), (b), ()",
                "(a,b), (a)",
                "(a,b), (a), ()",
                "(a,b), ()"
              ],
              "answer": 2,
              "explain": "Explicit list: (a,b) detail + (a) subtotal. Grand total () must be explicit."
            },
            {
              "q": "CUBE(a,b) equivalent GROUPING SETS:",
              "options": [
                "((a,b), (a), ())",
                "((a,b), (a), (b), ())",
                "((a,b), (a), (b))",
                "((a), (b), ())"
              ],
              "answer": 1,
              "explain": "CUBE = all 2^N combinations. For 2 cols: (a,b), (a), (b), ()."
            }
          ]
        }
      ]
    },
    {
      "title": "GROUPING() & GROUPING_ID() — Label Your Subtotals",
      "blocks": [
        {
          "type": "heading",
          "text": "Identify Subtotal Rows"
        },
        {
          "type": "code",
          "label": "grouping functions",
          "code": "-- GROUPING(col): 1 if col is NULL due to rollup, 0 if detail\nSELECT dept_id, status,\n  GROUPING(dept_id) AS g_dept,\n  GROUPING(status) AS g_status,\n  COUNT(*)\nFROM employees\nGROUP BY ROLLUP(dept_id, status);\n\n-- GROUPING_ID: bitmask of GROUPING() values\nSELECT dept_id, status,\n  GROUPING_ID(dept_id, status) AS gid,\n  COUNT(*)\nFROM employees\nGROUP BY CUBE(dept_id, status);\n-- gid: 0=detail, 1=status rolled, 2=dept rolled, 3=grand total\n\n-- Pretty labels\nSELECT \n  CASE WHEN GROUPING(dept_id)=1 THEN 'ALL DEPTS' ELSE dept_id END AS dept,\n  CASE WHEN GROUPING(status)=1 THEN 'ALL STATUS' ELSE status END AS status,\n  COUNT(*)\nFROM employees\nGROUP BY ROLLUP(dept_id, status);",
          "pg": "-- GROUPING, GROUPING_ID standard",
          "mysql": "-- MySQL 8.0+: GROUPING(), GROUPING_ID() supported",
          "py-pandas": "# No direct equivalent; use margins + detect NaN in index"
        },
        {
          "type": "visual",
          "kind": "table-diff",
          "spec": {
