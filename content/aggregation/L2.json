  "placementQuiz": [
    {
      "q": "ROLLUP(dept_id, status) produces:",
      "options": [
        "Only (dept_id, status) groups",
        "(dept_id, status) + (dept_id) + grand total",
        "All combinations of dept_id and status",
        "Only grand total"
      ],
      "answer": 1,
      "explain": "ROLLUP creates hierarchical subtotals: detail → subtotals → grand total."
    },
    {
      "q": "CUBE(dept_id, status) produces:",
      "options": [
        "Same as ROLLUP",
        "All 2^n combinations of grouping columns",
        "Only (dept_id) subtotals",
        "Only (status) subtotals"
      ],
      "answer": 1,
      "explain": "CUBE = all possible combinations: (dept,status), (dept), (status), ()."
    },
    {
      "q": "GROUPING SETS ((dept_id), (status)) produces:",
      "options": [
        "Same as CUBE",
        "Only dept_id groups + only status groups",
        "Only grand total",
        "Error"
      ],
      "answer": 1,
      "explain": "GROUPING SETS lets you pick exactly which grouping combinations you want."
    },
    {
      "q": "GROUPING(dept_id) returns 1 when:",
      "options": [
        "Row is a detail row",
        "Row is a subtotal for dept_id (dept_id is NULL in result)",
        "dept_id is NULL in source data",
        "Never"
      ],
      "answer": 1,
      "explain": "GROUPING(col) = 1 for super-aggregate rows where col was rolled up (NULL in output)."
