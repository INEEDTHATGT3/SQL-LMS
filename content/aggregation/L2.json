  "revisionCard": [
    "ROLLUP = N+1 levels (detail → subtotals → grand); CUBE = 2^N combinations",
    "GROUPING SETS = explicit list of grouping combinations; most flexible",
    "GROUPING(col) = 1 when col is NULL due to rollup (subtotal row)",
    "GROUPING_ID = bitmask: bit 0 = first col rolled, bit 1 = second col, etc.",
    "Partial ROLLUP: GROUP BY a, ROLLUP(b) = (a,b) + (a) subtotals",
    "COALESCE with GROUPING() for pretty subtotal labels"
  ],
  "glossary": [
    {
      "term": "ROLLUP",
      "def": "Hierarchical grouping: detail rows + progressive subtotals + grand total."
    },
    {
      "term": "CUBE",
      "def": "Cross-tabulation: all 2^N combinations of grouping columns."
    },
    {
      "term": "GROUPING SETS",
      "def": "Explicit list of grouping combinations to include."
    },
    {
      "term": "GROUPING()",
      "def": "Returns 1 if column is NULL due to rollup (subtotal), 0 if detail row."
    },
    {
      "term": "GROUPING_ID()",
      "def": "Bitmask of GROUPING() values for multiple columns. Bit i = GROUPING(col_i)."
    },
    {
      "term": "super-aggregate",
      "def": "A row produced by ROLLUP/CUBE/GROUPING SETS that represents a subtotal or grand total."
    }
  ]
}
