/* ============================================================
   {{skillName}} LAYERED STUDY SYSTEM — SHARED THEME
   Generated from theme-config.json via theme-compiler.js
   ============================================================ */
@import url('https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Syne:wght@400;600;700;800&family=DM+Mono:wght@400;500&display=swap');

:root {
  --bg:#0a0c0f; --surface:#111318; --surface2:#181c22; --border:#222831;
  --accent:{{palette.accent}}; --accent2:{{palette.accent2}}; --accent3:{{palette.accent3}};
  --warn:#fbbf24; --text:#c8d3e0; --text-dim:#5a6a7a;
  --text-bright:#eaf0fa; --red:#ff4d6d; --green:#00ff9d; --code-bg:#0d1117;
  /* level accents (set per-file by renderer via body[data-level]) */
  --lvl:{{levels.0.color}}; --lvl-rgba:{{rgba(levels.0.color, 0.1)}}; --lvl-border:{{rgba(levels.0.color, 0.25)}};
}
{{#levels}}
body[data-level="{{level}}"]{ --lvl:{{color}}; --lvl-rgba:{{rgba(color, 0.1)}}; --lvl-border:{{rgba(color, 0.25)}}; }
{{/levels}}

*{margin:0;padding:0;box-sizing:border-box;} html{scroll-behavior:smooth;}
body{background:var(--bg);color:var(--text);font-family:'Syne',sans-serif;line-height:1.7;overflow-x:hidden;}
body::before{content:'';position:fixed;inset:0;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E");pointer-events:none;z-index:999;opacity:0.4;}

/* ---------- HERO ---------- */
.hero{background:var(--surface);border-bottom:1px solid var(--border);padding:56px 40px 36px;position:relative;overflow:hidden;}
.hero::after{content:attr(data-watermark);position:absolute;right:-10px;top:-20px;font-size:180px;font-weight:800;color:var(--lvl-rgba);font-family:'Space Mono',monospace;pointer-events:none;}
.hero-tag{font-family:'Space Mono',monospace;font-size:11px;color:var(--lvl);letter-spacing:4px;text-transform:uppercase;margin-bottom:12px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
.hero-tag::before{content:'▶';}
.hero h1{font-size:clamp(34px,5vw,68px);font-weight:800;color:var(--text-bright);line-height:1.05;letter-spacing:-2px;}
.hero h1 span{color:var(--lvl);}
.hero .promise{max-width:720px;color:var(--text-dim);margin-top:14px;font-size:15px;}
.level-strip{display:flex;gap:10px;margin-top:22px;flex-wrap:wrap;}
.level-pill{font-family:'Space Mono',monospace;font-size:10px;letter-spacing:1px;padding:5px 12px;border-radius:3px;border:1px solid var(--border);color:var(--text-dim);text-decoration:none;background:var(--surface2);transition:all .2s;}
.level-pill:hover{transform:translateY(-2px);}
.level-pill.current{color:var(--bg);font-weight:700;border-color:transparent;background:var(--lvl);}
.level-pill.done::after{content:' ✓';color:var(--green);}

.badge{background:var(--lvl-rgba);border:1px solid var(--lvl-border);color:var(--lvl);padding:3px 10px;border-radius:3px;font-size:11px;font-family:'Space Mono',monospace;letter-spacing:1px;}
.badge.green{background:rgba(0,255,157,.08);border-color:rgba(0,255,157,.2);color:var(--green);}
.badge.pink{background:rgba(244,114,182,.08);border-color:rgba(244,114,182,.2);color:var(--accent2);}
.badge.blue{background:rgba(96,165,250,.08);border-color:rgba(96,165,250,.2);color:var(--accent3);}
.badge.amber{background:rgba(251,191,36,.08);border-color:rgba(251,191,36,.2);color:var(--warn);}

/* ---------- NAV ---------- */
nav.toc{background:var(--surface);border-bottom:1px solid var(--border);padding:0 40px;display:flex;overflow-x:auto;position:sticky;top:0;z-index:100;}
nav.toc a{color:var(--text-dim);text-decoration:none;padding:14px 15px;font-size:11px;font-family:'Space Mono',monospace;letter-spacing:1px;border-bottom:2px solid transparent;white-space:nowrap;transition:all 0.2s;}
nav.toc a:hover{color:var(--lvl);border-bottom-color:var(--lvl);}
.progress-wrap{position:sticky;top:43px;z-index:99;height:3px;background:var(--surface2);}
.progress-bar{height:100%;width:0%;background:linear-gradient(90deg,var(--lvl),var(--accent));transition:width .15s;}

.container{max-width:1100px;margin:0 auto;padding:48px 40px;}
.section{margin-bottom:72px;}
.section-header{display:flex;align-items:center;gap:14px;margin-bottom:32px;padding-bottom:16px;border-bottom:1px solid var(--border);}
.section-num{font-family:'Space Mono',monospace;font-size:11px;color:var(--lvl);letter-spacing:2px;min-width:40px;}
.section h2{font-size:28px;font-weight:700;color:var(--text-bright);letter-spacing:-0.5px;}
h3{font-size:17px;font-weight:700;color:var(--text-bright);margin:28px 0 14px;display:flex;align-items:center;gap:8px;}
h3::before{content:'//';color:var(--lvl);font-family:'Space Mono',monospace;font-size:13px;}
p{margin-bottom:12px;color:var(--text);font-size:15px;}

/* ---------- CODE ---------- */
pre,code{font-family:'DM Mono',monospace;}
pre{background:var(--code-bg);border:1px solid var(--border);border-left:3px solid var(--lvl);border-radius:6px;padding:20px 24px;overflow-x:auto;font-size:13px;line-height:1.8;margin:16px 0;}
.code-label{font-family:'Space Mono',monospace;font-size:10px;letter-spacing:2px;color:var(--text-dim);text-transform:uppercase;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;}
code{font-size:13px;background:var(--lvl-rgba);padding:2px 6px;border-radius:3px;color:var(--lvl);}
.kw{color:#c792ea;}.fn{color:#82aaff;}.st{color:#c3e88d;}.cm{color:#546e7a;font-style:italic;}.num{color:#f78c6c;}.cls{color:#ffcb6b;}.pp{color:#89ddff;}

/* language toggle - responsive dropdown for 4+ languages */
.lang-switch{display:inline-flex;position:relative;}
.lang-trigger{display:flex;align-items:center;gap:6px;padding:6px 12px;background:var(--surface2);border:1px solid var(--border);border-radius:4px;color:var(--text);font-family:'Space Mono',monospace;font-size:10px;letter-spacing:1px;cursor:pointer;}
.lang-trigger .chevron{width:12px;height:12px;transition:transform .2s;}
.lang-trigger[aria-expanded="true"] .chevron{transform:rotate(180deg);}
.lang-dropdown{position:absolute;top:100%;right:0;min-width:180px;background:var(--surface);border:1px solid var(--border);border-radius:4px;margin-top:4px;list-style:none;padding:8px 0;display:none;z-index:100;box-shadow:0 8px 24px rgba(0,0,0,0.3);}
.lang-dropdown[aria-hidden="false"]{display:block;}
.lang-dropdown li{padding:8px 16px;cursor:pointer;font-family:'Space Mono',monospace;font-size:10px;color:var(--text);transition:background .15s;}
.lang-dropdown li:hover{background:var(--lvl-rgba);color:var(--lvl);}
.lang-dropdown li.active{color:var(--lvl);background:var(--lvl-rgba);}
.lang-tabs{display:none;gap:8px;}
@media(min-width:700px){
  .lang-trigger{display:none;}
  .lang-dropdown{display:none;}
  .lang-tabs{display:flex;}
  .lang-tabs button{background:var(--surface2);border:1px solid var(--border);border-radius:4px;color:var(--text-dim);font-family:'Space Mono',monospace;font-size:10px;letter-spacing:1px;padding:4px 10px;cursor:pointer;}
  .lang-tabs button.on{background:var(--lvl);color:var(--bg);font-weight:700;}
}
body[data-lang="py"] pre[data-lang="cpp"].has-py-alt{display:none;}
body[data-lang="cpp"] pre[data-lang="py"]:not(.py-missing){display:none;}
pre.py-missing{display:none;border-left-color:var(--warn);}
body[data-lang="py"] pre.py-missing{display:block;}
.py-note{display:none;font-size:12px;color:var(--warn);font-family:'Space Mono',monospace;margin:-10px 0 14px;}
body[data-lang="py"] .py-note.has-missing{display:block;}

/* ---------- GRIDS / CARDS ---------- */
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:16px 0;}
.grid-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;margin:16px 0;}
.grid-4{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:14px;margin:16px 0;}
@media(max-width:700px){.grid-2,.grid-3,.grid-4{grid-template-columns:1fr;}}
.card{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:20px;position:relative;overflow:hidden;}
.card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--lvl),transparent);}
.card-title{font-size:12px;font-family:'Space Mono',monospace;letter-spacing:2px;color:var(--lvl);text-transform:uppercase;margin-bottom:10px;}
.mantra{background:var(--lvl-rgba);border:1px dashed var(--lvl-border);border-radius:8px;padding:16px 20px;margin:18px 0;font-size:16px;color:var(--text-bright);}
.mantra::before{content:'⌘ MANTRA';display:block;font-family:'Space Mono',monospace;font-size:9px;letter-spacing:3px;color:var(--lvl);margin-bottom:6px;}

/* ---------- CALLOUTS ---------- */
.callout{border-left:3px solid var(--accent);background:rgba(163,230,53,0.05);padding:14px 18px;margin:16px 0;border-radius:0 6px 6px 0;font-size:14px;}
.callout.blue{border-color:var(--accent3);background:rgba(96,165,250,0.05);}
.callout.pink{border-color:var(--accent2);background:rgba(244,114,182,0.05);}
.callout.red{border-color:var(--red);background:rgba(255,77,109,0.05);}
.callout.warn{border-color:var(--warn);background:rgba(251,191,36,0.05);}
.callout.green{border-color:var(--green);background:rgba(0,255,157,0.05);}
.callout strong{color:var(--text-bright);}

/* ---------- VISUALS ---------- */
.arr-vis{display:flex;align-items:stretch;margin:16px 0;background:var(--code-bg);border:1px solid var(--border);border-radius:8px;overflow:hidden;}
.arr-cell{flex:1;display:flex;flex-direction:column;align-items:center;border-right:1px solid var(--border);min-width:52px;}
.arr-cell:last-child{border-right:none;}
.arr-val{padding:14px 8px;font-family:'DM Mono',monospace;font-size:16px;font-weight:700;color:var(--text-bright);text-align:center;width:100%;border-bottom:1px solid var(--border);}
.arr-idx{padding:6px 4px;font-family:'Space Mono',monospace;font-size:10px;color:var(--text-dim);text-align:center;letter-spacing:1px;}
.arr-cell.hi .arr-val{background:var(--lvl-rgba);color:var(--lvl);}
.mem-map{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin:16px 0;}
.mem-seg{background:var(--code-bg);border:1px solid var(--border);border-radius:6px;padding:14px;text-align:center;}
.mem-seg .seg-name{font-family:'Space Mono',monospace;font-size:11px;letter-spacing:2px;color:var(--lvl);text-transform:uppercase;}
.mem-seg .seg-desc{font-size:12px;color:var(--text-dim);margin-top:6px;}
.flow-steps{counter-reset:fs;margin:16px 0;}
.flow-step{position:relative;padding:10px 16px 10px 52px;border:1px solid var(--border);border-top:none;background:var(--surface);}
.flow-step:first-child{border-top:1px solid var(--border);border-radius:8px 8px 0 0;}
.flow-step:last-child{border-radius:0 0 8px 8px;}
.flow-step::before{counter-increment:fs;content:counter(fs);position:absolute;left:14px;top:12px;width:24px;height:24px;border-radius:50%;background:var(--lvl-rgba);color:var(--lvl);font-family:'Space Mono',monospace;font-size:12px;display:flex;align-items:center;justify-content:center;border:1px solid var(--lvl-border);}

/* ---------- TRACE TABLE ---------- */
table.trace{width:100%;border-collapse:collapse;margin:16px 0;font-family:'DM Mono',monospace;font-size:13px;}
table.trace th{background:var(--surface2);color:var(--lvl);padding:9px 12px;text-align:left;font-size:11px;letter-spacing:2px;text-transform:uppercase;border:1px solid var(--border);font-family:'Space Mono',monospace;}
table.trace td{padding:8px 12px;border:1px solid var(--border);vertical-align:top;}
table.trace tr:nth-child(even) td{background:rgba(255,255,255,0.02);}
table.generic{width:100%;border-collapse:collapse;margin:16px 0;font-size:13px;}
table.generic th{background:var(--surface2);color:var(--lvl);padding:10px 14px;text-align:left;font-size:11px;letter-spacing:2px;text-transform:uppercase;border:1px solid var(--border);font-family:'Space Mono',monospace;}
table.generic td{padding:10px 14px;border:1px solid var(--border);vertical-align:top;}
.tc{text-align:center;} .green-t{color:var(--green);} .orange-t{color:var(--warn);} .red-t{color:var(--red);} .blue-t{color:var(--accent3);} .pink-t{color:var(--accent2);}

/* ---------- REVEAL ---------- */
.reveal-btn{background:var(--lvl-rgba);border:1px solid var(--lvl-border);color:var(--lvl);font-family:'Space Mono',monospace;font-size:10px;letter-spacing:2px;padding:6px 14px;border-radius:4px;cursor:pointer;text-transform:uppercase;transition:all .2s;}
.reveal-btn:hover{background:var(--lvl);color:var(--bg);}
.reveal-target{display:none;margin-top:12px;}
.reveal-target.open{display:block;animation:fadeIn .25s ease;}
@keyframes fadeIn{from{opacity:0;transform:translateY(-4px);}to{opacity:1;transform:none;}}

/* ---------- QUIZ / MCQ ---------- */
.quiz-card{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:22px;margin:16px 0;}
.quiz-q{color:var(--text-bright);font-weight:600;margin-bottom:14px;font-size:15px;}
.quiz-opts{display:grid;gap:8px;}
.quiz-opt{background:var(--surface2);border:1px solid var(--border);border-radius:6px;padding:11px 16px;cursor:pointer;font-size:14px;transition:all .15s;display:flex;gap:10px;align-items:baseline;}
.quiz-opt:hover{border-color:var(--lvl);}
.quiz-opt .opt-key{font-family:'Space Mono',monospace;font-size:11px;color:var(--text-dim);}
.quiz-opt.correct{border-color:var(--green);background:rgba(0,255,157,0.07);color:var(--green);}
.quiz-opt.wrong{border-color:var(--red);background:rgba(255,77,109,0.07);color:var(--red);}
.quiz-opt.locked{cursor:default;opacity:.75;}
.quiz-explain{display:none;margin-top:12px;font-size:13px;color:var(--text-dim);border-left:3px solid var(--lvl);padding:8px 14px;background:var(--code-bg);border-radius:0 6px 6px 0;}
.quiz-explain.show{display:block;}
.quiz-score{font-family:'Space Mono',monospace;font-size:11px;letter-spacing:1px;color:var(--lvl);margin-top:12px;}
#placement-result{margin-top:16px;padding:16px;border-radius:6px;border:1px solid var(--border);display:none;font-size:14px;}
#placement-result.show{display:block;}

/* ---------- PROBLEM LIST ---------- */
.prob-list{list-style:none;}
.problem-item{background:var(--surface);border:1px solid var(--border);border-top:none;padding:16px 18px;}
.problem-item:first-child{border-top:1px solid var(--border);border-radius:8px 8px 0 0;}
.problem-item:last-child{border-radius:0 0 8px 8px;}
.problem-head{display:flex;align-items:flex-start;gap:14px;flex-wrap:wrap;}
.diff{font-family:'Space Mono',monospace;font-size:10px;padding:2px 8px;border-radius:3px;min-width:44px;text-align:center;flex-shrink:0;margin-top:2px;}
.diff.t1{background:rgba(0,255,157,.1);color:var(--green);border:1px solid rgba(0,255,157,.2);}
.diff.t2{background:rgba(96,165,250,.1);color:var(--accent3);border:1px solid rgba(96,165,250,.2);}
.diff.t3{background:rgba(244,114,182,.1);color:var(--accent2);border:1px solid rgba(244,114,182,.2);}
.diff.t4{background:rgba(251,191,36,.1);color:var(--warn);border:1px solid rgba(251,191,36,.2);}
.prob-name{color:var(--text-bright);font-weight:600;font-size:15px;}
.prob-meta{color:var(--text-dim);font-size:12px;font-family:'Space Mono',monospace;margin-top:2px;}
.prob-actions{margin-left:auto;display:flex;gap:8px;align-items:center;}
.solved-check{display:flex;align-items:center;gap:6px;cursor:pointer;font-family:'Space Mono',monospace;font-size:10px;color:var(--text-dim);letter-spacing:1px;user-select:none;}
.solved-check input{accent-color:var(--green);cursor:pointer;}
.solved-check input:checked + span{color:var(--green);}
.prob-body{margin-top:12px;font-size:14px;}
.prob-hints .reveal-btn{margin-right:8px;margin-top:8px;}
.followup-chain{margin-top:14px;border-left:2px solid var(--accent2);padding-left:16px;}
.followup-item{margin:10px 0;}
.followup-q{color:var(--accent2);font-weight:600;font-size:13px;font-family:'Space Mono',monospace;cursor:pointer;}
.followup-a{display:none;color:var(--text);font-size:13px;padding:8px 0 2px;}
.followup-a.open{display:block;}

/* ---------- COMPLETE FOOTER ---------- */
.complete-box{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:24px;margin:48px 0;text-align:center;}
.complete-box button{background:var(--lvl);border:none;color:var(--bg);font-family:'Space Mono',monospace;font-weight:700;font-size:12px;letter-spacing:2px;padding:12px 28px;border-radius:4px;cursor:pointer;text-transform:uppercase;}
.complete-box button.done{background:var(--surface2);color:var(--green);border:1px solid var(--green);}

/* revision card + glossary */
.rev-card{background:linear-gradient(135deg,var(--surface),var(--code-bg));border:1px solid var(--lvl-border);border-radius:8px;padding:24px;margin:16px 0;}
.rev-card h4{font-family:'Space Mono',monospace;font-size:11px;letter-spacing:3px;color:var(--lvl);margin-bottom:14px;}
.rev-card ul{list-style:none;}
.rev-card li{padding:6px 0 6px 20px;position:relative;font-size:14px;color:var(--text-bright);}
.rev-card li::before{content:'▸';color:var(--lvl);position:absolute;left:0;}
ul.notes{padding-left:0;list-style:none;}
ul.notes li{padding:5px 0 5px 18px;position:relative;font-size:14px;color:var(--text);}
ul.notes li::before{content:'─';color:var(--lvl);position:absolute;left:0;}

.footer{border-top:1px solid var(--border);margin-top:64px;padding:32px 40px;text-align:center;color:var(--text-dim);font-family:'Space Mono',monospace;font-size:11px;letter-spacing:2px;}

@media(max-width:700px){
  .container{padding:24px 16px;} .hero{padding:36px 16px 28px;} nav.toc{padding:0 12px;}
  .arr-cell{min-width:40px;} .arr-val{font-size:13px;}
}